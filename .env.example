OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Use a dedicated Base Sepolia test wallet. Never put a mainnet key here.
EVM_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHAR_TEST_PRIVATE_KEY
# Exact payout address the buyer trusts; configure the seller to use the same address.
PAY_TO=0xREPLACE_WITH_40_HEX_CHAR_ADDRESS

FACILITATOR_URL=https://x402.org/facilitator
SELLER_URL=http://localhost:4021
SELLER_PORT=4021
ROGUE_TOKEN_ADDRESS=0x2222222222222222222222222222222222222222

# USDC atomic units: 1 USDC = 1,000,000 units.
MAX_PER_CALL_ATOMIC=250000
RUN_BUDGET_ATOMIC=5000000
AUDIT_PATH=records/run.jsonl